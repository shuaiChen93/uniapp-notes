{
  "name": "private-notebook",
  "version": "1.0.0",
  "private": true,
  "description": "私密记事本 —— 基于 uni-app + Vue3 + TypeScript 的本地记事小程序，带 6 位 PIN 密码锁",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "pinia": "^2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/runtime-core": "^3.4.21",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "5.2.8",
    "vitest": "2.1.9",
    "vue-tsc": "^2.2.0",
    "weapp-tailwindcss": "^4.12.0"
  }
}

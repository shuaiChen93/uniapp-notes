# uni-app 全家桶内部存在「深层依赖之间互相 require」的写法（非标准 npm 依赖树），
# pnpm 默认的严格符号链接隔离会让这些包解析不到彼此，因此提升为扁平结构。
# 等价于 npm 的 node_modules 布局，是 uni-app + pnpm 组合的通行配置。
shamefully-hoist=true

# 部分 uni-app 包声明的 peer 范围较旧，严格校验会产生大量无用告警并中断安装
strict-peer-dependencies=false

# 安装时自动安装缺失的 peer 依赖，避免手动补齐
auto-install-peers=true

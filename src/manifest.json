{
  // ──────────────────────────────────────────────────────────────────────
  // 应用标识
  // appid 留空：需你在微信公众平台申请后填入。
  // ⚠️ 要填的是下面 mp-weixin 里那一个（哪个生效、为什么，见那里的注释）。
  // ──────────────────────────────────────────────────────────────────────
  "name": "私密记事本",
  // ⚠️ 这一个 appid 对小程序端**不生效**（实测：改它，产物的
  // project.config.json 仍然写 touristappid）。真正生效的是下面
  // mp-weixin.appid。两处都留着是因为 uni 的其它端与部分工具链会读顶层
  // 这一份，保持与 mp-weixin 一致可以避免「两个地方写着不同的 appid」。
  "appid": "wx21dc2df651905fa5",
  "description": "带密码锁的本地私密记事本，数据只存在手机里",
  "versionName": "1.0.0",
  "versionCode": "100",
  // transformPx 关闭：uni-app 的 px→rpx 自动转换会与 Tailwind 的单位体系打架
  // （Tailwind 输出 rem，由 weapp-tailwindcss 的 rem2rpx 统一换算）。
  // 两套换算机制同时开工会产生"同一份设计稿出现两种实际尺寸"的问题，故明确关掉前者。
  "transformPx": false,

  // ──────────────────────────────────────────────────────────────────────
  // App 端（5+App / uni-app x 原生）
  // 本项目主战场是小程序，App 端保留最小可用配置
  // ──────────────────────────────────────────────────────────────────────
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        // ⚠️ 权限清单已按「纯本地应用」缩减到最小：
        // 本应用不联网、不上传任何数据，因此相机 / 存储 / 定位 / 电话
        // 等权限全部移除。唯一保留的 INTERNET 是 uni-app 运行时
        // （资源加载、崩溃日志）所必需，移除会导致 App 端启动异常。
        // 权限越少，应用市场与小程序审核的问询越少。
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },

  // ──────────────────────────────────────────────────────────────────────
  // H5：本项目的「调试主力端」
  // 小程序 IDE 启动慢、日志差，交互与样式优先在 H5 上验证
  // ⚠️ H5 端没有小程序 storage 的隔离机制，用的是浏览器 localStorage，
  //    调试时注意别把演示数据当成真实数据
  // ──────────────────────────────────────────────────────────────────────
  "h5": {
    "title": "私密记事本",
    "router": {
      // base 用相对路径 "./"，让 dist 产物可以直接丢到任意子目录下的静态服务器
      "base": "./",
      // hash 模式：避免静态托管时刷新 404（无需服务端 rewrite 规则）
      "mode": "hash"
    },
    "devServer": {
      "port": 5173,
      "https": false
    },
    "optimization": {
      "treeShaking": {
        "enable": true
      }
    }
  },

  // ──────────────────────────────────────────────────────────────────────
  // 微信小程序：本项目的交付目标端
  // ──────────────────────────────────────────────────────────────────────
  "mp-weixin": {
    // ⭐ 只认这一处。填上自己的小程序 appid 后重新构建，
    // 产物的 project.config.json 里就会带上它（已实测）。
    // 留空时产物写的是 touristappid —— 开发者工具会以「游客身份」
    // 打开，能预览、但**不能真机调试、不能上传**。
    "appid": "wx21dc2df651905fa5",
    "setting": {
      // 本应用不发任何网络请求，urlCheck 保持关闭以省去开发期的域名配置。
      // 上线时也不需要开——没有 request 就不存在合法域名问题。
      "urlCheck": false,
      "es6": true,
      "minified": true,
      // 关闭微信开发者工具自带的 postcss 处理：
      // 样式链路由 Vite + PostCSS + weapp-tailwindcss 统一负责，
      // 再叠一层 IDE 的 postcss 会对已转义的类名做二次处理，产生难排查的样式错乱
      "postcss": false,
      "enhance": true
    },
    "usingComponents": true,
    // 按需注入：只初始化当前页面用到的组件，显著降低冷启动耗时（必开项）
    "lazyCodeLoading": "requiredComponents",
    /**
     * 需要申请的非敏感权限：本应用**没有任何一条**。
     *
     * 这不是漏写，而是这个应用的性质决定的——它一个微信的隐私接口都不调：
     *   · 不调 wx.login / 不取 OpenID（没有账号体系）；
     *   · 不取头像昵称（本版没做个性化，即便做了也不用 getUserProfile）；
     *   · 不取定位、不取相册、不读剪贴板。
     *
     * 后果是审核侧的成本极低：小程序后台的《用户隐私保护指引》里
     * 没有任何「用户信息」项需要勾选，也不需要为此写收集用途说明。
     * 若将来真的要加头像昵称（chooseAvatar / input type="nickname"），
     * 那时才需要去后台补声明，否则真机上那两个控件会直接无响应。
     *
     * 隐私声明的文案见 pages/settings/settings.vue 的「隐私说明」一节，
     * 那份文案就是后台填表时的依据。
     */
    "requiredPrivateInfos": []
  },

  // ──────────────────────────────────────────────────────────────────────
  // 其他端：本项目不产出，保持最小声明
  // ──────────────────────────────────────────────────────────────────────
  "mp-alipay": { "usingComponents": true },
  "mp-baidu": { "usingComponents": true },
  "mp-toutiao": { "usingComponents": true },
  "quickapp": {},

  // 官方 uni 统计，本项目不启用（避免额外的隐私合规声明成本）
  "uniStatistics": { "enable": false },
  "vueVersion": "3"
}

{
  // ──────────────────────────────────────────────────────────────────────
  // 页面注册表
  //
  // 本应用只有 5 个页面，且全部是纯本地功能、没有需要懒加载的重型依赖
  // （无图表、无富文本编辑器），因此**不使用分包**：5 个页面加起来
  // 远小于主包 2MB 上限，拆分包反而会引入跨包跳转的加载等待。
  //
  // 数组第一项即启动页，必须是首页，否则冷启动会先落到别的页面。
  // ──────────────────────────────────────────────────────────────────────
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "私密记事本",
        // 全部页面都关掉原生导航栏，改用 x-page-shell 自绘。
        // 原因：原生导航栏的背景色与文字色在主题切换时无法跟着变
        // （它由小程序原生层绘制，读不到页面里的 CSS 变量），
        // 冬天切到暗色主题时会留下一条刺眼的浅色栏。
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/edit/edit",
      "style": {
        "navigationBarTitleText": "写记事",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationBarTitleText": "记事详情",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/settings/settings",
      "style": {
        "navigationBarTitleText": "设置",
        "navigationStyle": "custom"
      }
    },
    {
      // 锁页放在最后：它是**跳转目标**而不是入口，
      // 位置本身不影响功能，放在末尾便于阅读时区分「主流程」与「拦截页」
      "path": "pages/lock/lock",
      "style": {
        "navigationBarTitleText": "解锁",
        "navigationStyle": "custom",
        // 锁屏是一个「必须处理完才能离开」的界面，禁止滚动回弹，
        // 避免用户下意识下拉时看到回弹动画而以为页面出错了
        "disableScroll": true
      }
    }
  ],

  // ──────────────────────────────────────────────────────────────────────
  // 全局样式：与 App.vue 里 `--color-bg-base`（浅色）保持一致。
  // 小程序在页面切换的空档会露出这层底色，两者不一致就会闪一下。
  // ──────────────────────────────────────────────────────────────────────
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "私密记事本",
    "navigationBarBackgroundColor": "#F7F6F3",
    "backgroundColor": "#F7F6F3",
    "backgroundColorTop": "#F7F6F3",
    "backgroundColorBottom": "#F7F6F3"
  },

  // ──────────────────────────────────────────────────────────────────────
  // easycom：组件自动按需引入。
  // 本项目自研组件统一以 x- 开头——凡是模板里写了 <x-xxx>，
  // 编译器自动补 import，无需在每个页面手写 import 语句，
  // 同时也保证未使用的组件不会被打进包（真正的按需）。
  // ──────────────────────────────────────────────────────────────────────
  "easycom": {
    "autoscan": true,
    "custom": {
      "^x-(.*)": "@/components/x-$1/x-$1.vue"
    }
  },

  // ──────────────────────────────────────────────────────────────────────
  // 自定义编译模式：开发期在开发者工具里可一键直达指定页面并携带参数，
  // 省去「启动→点好几层→才到目标页」的重复操作。仅开发期生效，不影响线上。
  // ──────────────────────────────────────────────────────────────────────
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index"
      },
      {
        "name": "新建记事",
        "path": "pages/edit/edit"
      },
      {
        "name": "设置页",
        "path": "pages/settings/settings"
      },
      {
        "name": "锁屏页",
        "path": "pages/lock/lock"
      }
    ]
  }
}
